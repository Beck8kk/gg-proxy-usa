-- LocalScript - Deve ser colocado em StarterPlayer -> StarterPlayerScripts ou StarterGui

local player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local playerGui = player:WaitForChild("PlayerGui")

-- Criar RemoteEvent para comunicação
local AutoFarmHub = Instance.new("RemoteEvent")
AutoFarmHub.Name = "AutoFarmHub"
AutoFarmHub.Parent = ReplicatedStorage

-- Criação da Interface Gráfica (Hub)
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = playerGui
screenGui.Name = "AutoFarmHubUI"

local ativarButton = Instance.new("TextButton")
ativarButton.Size = UDim2.new(0, 200, 0, 50)
ativarButton.Position = UDim2.new(0.5, -100, 0.5, -60)
ativarButton.Text = "Ativar Auto-Farm"
ativarButton.Parent = screenGui

local desativarButton = Instance.new("TextButton")
desativarButton.Size = UDim2.new(0, 200, 0, 50)
desativarButton.Position = UDim2.new(0.5, -100, 0.5, 20)
desativarButton.Text = "Desativar Auto-Farm"
desativarButton.Parent = screenGui

local ativo = false  -- Controle para saber se o auto-farm está ativo

-- Função para ativar o Auto-Farm
local function ativarAutoFarm()
    ativo = true
    while ativo do
        -- Aqui você coloca a ação para o personagem ganhar força automaticamente
        -- Por exemplo, o personagem interage com um peso
        local peso = game.Workspace:FindFirstChild("Weight")  -- Verifica se existe o objeto "Weight"
        if peso then
            -- Simula o clique no peso
            fireclickdetector(peso.ClickDetector)  -- Interage com o ClickDetector do peso
            
            -- Espera 1 segundo antes de repetir
            wait(1)
        end
    end
end

-- Função para desativar o Auto-Farm
local function desativarAutoFarm()
    ativo = false
end

-- Conectar eventos dos botões para ativar/desativar o auto-farm
ativarButton.MouseButton1Click:Connect(function()
    -- Enviar evento para o servidor para ativar o auto-farm
    AutoFarmHub:FireServer("ativar")
end)

desativarButton.MouseButton1Click:Connect(function()
    -- Enviar evento para o servidor para desativar o auto-farm
    AutoFarmHub:FireServer("desativar")
end)

-- Script do servidor (Dentro do Script Server, para controlar a ativação/desativação)
AutoFarmHub.OnServerEvent:Connect(function(player, acao)
    if acao == "ativar" then
        -- Acionar no cliente a função de ativação do Auto-Farm
        game.ReplicatedStorage.AutoFarmHub:FireClient(player, "ativar")
    elseif acao == "desativar" then
        -- Acionar no cliente a função de desativação do Auto-Farm
        game.ReplicatedStorage.AutoFarmHub:FireClient(player, "desativar")
    end
end)

-- Receber comando do servidor para ativar ou desativar o Auto-Farm
AutoFarmHub.OnClientEvent:Connect(function(acao)
    if acao == "ativar" then
        ativarAutoFarm()
    elseif acao == "desativar" then
        desativarAutoFarm()
    end
end)
